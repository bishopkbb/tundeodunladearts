.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production
.env*
!*.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentation and setup guides (not needed in repo)
SUPABASE_SETUP_GUIDE.md
PRODUCTION_READY_SUMMARY.md
**/PRODUCTION_SETUP.md
**/UPDATE_*.md

